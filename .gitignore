# ── 目录结构：前后端分离 ────────────────────────────────────────────────────
# 前端产物与依赖只在 frontend/ 下产生
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.*.local

# 兜底（防止在仓库其它位置误装）
node_modules/
dist/

# ── 环境变量（含 API Key，切勿提交）──────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 后端运行产物 ─────────────────────────────────────────────────────────────
# 生成图归档、轨迹 JSONL、指标快照、评估报告：均为运行期数据，不入库
backend/var/
backend/data/raw/
backend/training/out/
backend/training/data/

# ── 运行期日志 ───────────────────────────────────────────────────────────────
# 本地 dev server / 测试 / 自检脚本重定向出来的输出，不属于源码
*.log

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
