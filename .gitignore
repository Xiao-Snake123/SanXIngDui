# ── 目录结构：前后端分离 ────────────────────────────────────────────────────
# 前端产物与依赖只在 frontend/ 下产生
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.*.local

# 兜底（防止在仓库其它位置误装）
node_modules/
dist/

# ── 环境变量（含 API Key，切勿提交）──────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 后端运行产物 ─────────────────────────────────────────────────────────────
# 生成图归档、轨迹 JSONL、指标快照、评估报告：均为运行期数据，不入库
backend/var/
backend/data/raw/
backend/training/out/
backend/training/data/

# ── 运行期日志 ───────────────────────────────────────────────────────────────
# 本地 dev server / 测试 / 自检脚本重定向出来的输出，不属于源码
*.log

# ── 临时调试脚本与一次性测试输出 ─────────────────────────────────────────────
# 下划线前缀的脚本是排查问题时临时写的，不作为仓库源码
backend/_test_*.py
backend/test_*_out.txt
backend/test_refuse_results.txt
backend/*.err

# ── 工具缓存与体积较大的验证产物 ─────────────────────────────────────────────
.playwright-cli/
# UI 走查截图集（约 5MB 二进制），不入库；README 引用的 docs/screenshots/ 除外
docs/testing/

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
