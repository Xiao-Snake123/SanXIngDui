# ════════════════════════════════════════════════════════════════════════════
#  三星堆文物复原 Multi-Agent 系统 —— 后端配置
#  复制为 backend/.env 后按需填写。所有 Key 均为可选：
#  未填写时系统自动降级到本地/规则实现，全链路仍可跑通（结果可预期地变弱）。
# ════════════════════════════════════════════════════════════════════════════

# ── 服务 ─────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8123
LOG_LEVEL=INFO
# 逗号分隔；前端 dev server 与生产域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8023

# ── 编排引擎 ─────────────────────────────────────────────────────────────────
# langgraph | builtin
ENGINE_BACKEND=langgraph
# 质检不通过时最多回炉次数（Self-Correction 循环上限）
MAX_REVISIONS=2
# 风格一致性通过阈值（0~1），低于该值触发回炉
STYLE_THRESHOLD=0.72
# 单次复原任务的最大图节点跳转次数（防止 supervisor 死循环）
# 正常路径（含 2 次回炉）约 14 步，18 留出余量
MAX_GRAPH_STEPS=18

# ── DashScope（阿里云百炼，OpenAI 兼容模式）──────────────────────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ── 模型选型（全部可覆盖，详见 docs/MODEL_SELECTION.md）──────────────────────
MODEL_SUPERVISOR=qwen3-max
MODEL_PLANNER=qwen3-max
MODEL_RETRIEVAL=qwen-plus
MODEL_COPYWRITER=qwen3-max
MODEL_JUDGE=qwen3-vl-plus
MODEL_VLM=qwen3-vl-plus
MODEL_EMBEDDING=text-embedding-v3
MODEL_RERANK=gte-rerank-v2

# ── 出图（全代码/API 模式，无需本地 GPU、无需 ComfyUI）───────────────────────
# 选模型看「材质还原」而不是「画得漂亮」：文物复原最容易翻车的地方是
# 青铜锈层的颗粒感、锤撰金箔的哑金质感、玉的温润透光。
# 可选（都是同步接口，改这一行即可切换）：
#   qwen-image-3.0-pro   最新旗舰，提示词遵循与材质表现最好，价格最高
#   qwen-image-2.0-pro   推荐默认：真实质感与语义遵循好，支持自由宽高
#   qwen-image-max       真实感强、AI 合成痕迹低，但只支持固定预设尺寸
#   qwen-image-plus      更便宜，擅长多样化艺术风格
#   z-image-turbo        最快最便宜，适合先把链路跑通
MODEL_IMAGE=qwen-image-2.0-pro

# 出图端点路径。qwen-image 全系列用 multimodal-generation（同步，无需轮询）。
# 若改用 wan 系列（需要 4K 或 color_palette 色板控制），改成
#   /api/v1/services/aigc/text2image/image-synthesis
IMAGE_ENDPOINT_PATH=/api/v1/services/aigc/multimodal-generation/generation
# 提示词增强：交给模型扩写提示词。
# 一定要保持 false —— 提示词是我们拼好、并且向用户承诺「逐字使用」的，
# 被模型改写等于架空锁定契约与质检标尺。
IMAGE_PROMPT_EXTEND=false
# 是否在图上打「AI 生成」水印（百炼默认 false，这里显式写出便于审计）
IMAGE_WATERMARK=false
IMAGE_TIMEOUT=300

MODEL_FALLBACK_CHAT=qwen-plus
MODEL_FALLBACK_VLM=qwen-vl-max

# ── 免鉴权第三方出图通道（没有 Key 时的真实出图兜底，不推荐生产）────────────
# 出图优先级：DashScope → 第三方免鉴权 → 本地占位图
# 代价：配额低（匿名档每 15 秒 1 次）、带水印、内容审核不受本项目控制。
# 仅用于「零配置也能看到真实产物」的首次体验；生产环境请设为 false。
FREEIMAGE_ENABLED=true
# 模型名会随上游调整而失效。实测 2026-09：GET https://image.pollinations.ai/models
# 只返回 ["sana"]，旧的 flux 已下线（传旧名会落到随机模型并频繁触发限流）。
FREEIMAGE_MODEL=sana
FREEIMAGE_TIMEOUT=120
# 提示词预算。**这个值是实测出来的，不是猜的**，别调大：
# 复现见 scripts/probe_freeimage_tail.py —— 288 字时尾部仍生效，436 字时尾部被
# 静默丢弃（最大像素差 0）。调大预算不会让模型看到更多，只会让超窗部分悄悄消失，
# 重新制造「回炉了但画面逐像素不变」那个 bug。
FREEIMAGE_MAX_PROMPT_CHARS=256
# 免费注册 https://auth.pollinations.ai 可获得 token：配额从 15s/次 提升到 5s/次，并去水印
FREEIMAGE_TOKEN=
# 匿名档是 15 秒一个窗口，退避必须跨越它，否则重试一定撞在同一窗口上
FREEIMAGE_ATTEMPTS=2
FREEIMAGE_BACKOFF_SECONDS=16
FREEIMAGE_URL_TEMPLATE=https://image.pollinations.ai/prompt/{prompt}?width={width}&height={height}&model={model}&nologo=true&seed={seed}

# ── 本地 QLoRA 微调权重（存在时作为文物理解/风格判定的首选）──────────────────
LORA_BASE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LORA_ADAPTER_PATH=
LORA_ENABLED=false

# ── 检索 ─────────────────────────────────────────────────────────────────────
CORPUS_DIR=data/corpus
RETRIEVAL_TOP_K=8
RETRIEVAL_RERANK_TOP_N=4
# BM25 与向量分数的融合权重（alpha 给 BM25，1-alpha 给向量）。
# **0.20 是实测最优值**（原默认 0.45 从未被验证过）：
# 扫描结果见 config.py 里的注释表 —— 相对 0.45，recall@1 +0.070、MRR +0.038，
# 而 recall@5/10 与漏召数持平。
# 注意权衡：越偏 BM25，recall@10 越好、漏召越少，但首条命中率下降。
# 若启用 rerank 精排（gte-rerank-v2），应重新扫描并偏向 0.60 附近。
HYBRID_ALPHA=0.20

# ── 观测 ─────────────────────────────────────────────────────────────────────
TRACE_DIR=var/traces
METRICS_DIR=var/metrics
# 是否把每张生成图落盘归档（便于事后人工复核）
ARCHIVE_OUTPUTS=true
OUTPUT_DIR=var/outputs

# ── PostgreSQL：任务 / 产物 / 质检记录落库 ───────────────────────────────────
# 留空 = 不启用（任务只留在进程内与 JSONL trace 里，重启即丢）。
# 本机已装好 PostgreSQL 17.6 + pgvector 0.8.6，直接可用（见 docs/STORAGE.md）。
# 生产请连同 SSL 参数一起配：?sslmode=require
DATABASE_URL=postgresql+asyncpg://sxd:sxd_app_2026@127.0.0.1:5432/sanxingdui
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
# 启动时自动把 schema 升到最新（Alembic）。多副本生产环境建议改 false，
# 改成发布流程里单独跑 python scripts/migrate.py。
DB_AUTO_MIGRATE=true
DB_CONNECT_TIMEOUT=5

# ── pgvector：语料向量持久化与 HNSW 召回 ─────────────────────────────────────
# 维度必须与 embedder 输出一致：
#   配了 Key -> text-embedding-v3 的 1024 维
#   无 Key   -> 本地哈希向量（HashingEmbedder，同样按 VECTOR_DIM 生成）
# 改了维度需要重建表：python scripts/migrate.py --recreate-vectors
VECTOR_DIM=1024
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64
# 命中库中已有且 embedder 名一致的向量时跳过 embedding 调用（重启不再重复花钱）
VECTOR_REUSE=true

# ── Redis：会话存储 ──────────────────────────────────────────────────────────
# 留空 / 连不上 = 退回进程内实现（行为一致，只是不能跨进程、重启即丢）。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=sxd
# 会话空闲多久回收（秒）。与进程内实现的 SESSION_TTL_SECONDS 语义一致。
REDIS_SESSION_TTL_SECONDS=1800
# 会话数量上限；超出后按「最久未活动」淘汰
REDIS_MAX_SESSIONS=200
REDIS_CONNECT_TIMEOUT=3
