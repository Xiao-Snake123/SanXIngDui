# ════════════════════════════════════════════════════════════════════════════
#  前端环境变量（Vite 只暴露 VITE_ 前缀给浏览器；其余仅供 dev server 代理使用）
#  复制为 .env.local 后按需填写。所有 Key 均可留空，系统会自动降级。
# ════════════════════════════════════════════════════════════════════════════

# ── 多智能体后端（FastAPI + LangGraph）────────────────────────────────────────
# dev server 与生产 server.mjs 都会把 /agent 代理到这里
AGENT_BACKEND_URL=http://127.0.0.1:8000

# ── 通义千问 / 百炼（可选）────────────────────────────────────────────────────
# 留空时：LLM/VLM/Embedding 层降级为规则与本地实现，功能可用但效果下降。
# 建议把 Key 只放在 backend/.env（写在 VITE_ 前缀下会被打包进前端产物）。
DASHSCOPE_API_KEY=
VITE_DASHSCOPE_API_KEY=

# ── 讲解助手 Chat App（可选）──────────────────────────────────────────────────
CHAT_APP_API_KEY=
VITE_CHAT_APP_API_KEY=
